# Copy to .env on the server. Never commit real secrets.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-unique-password
DATABASE_PATH=./data/app.db

# Click.ru API token. Rotate any token that was pasted into chat or another public place.
CLICKRU_API_TOKEN=

# Yandex OAuth authorization-code flow — used ONLY by /lk members (see
# lk.py, "Конверсии в Метрику") to connect their own Yandex ID and pick a
# Metrika counter. The main admin bulk-create flow below never uses this.
# Create an app at https://oauth.yandex.ru/ and grant metrika:read plus metrika:write.
METRIKA_OAUTH_CLIENT_ID=
METRIKA_OAUTH_CLIENT_SECRET=
# Must exactly match the Redirect URI configured in the Yandex OAuth app; use ASCII/Punycode host.
METRIKA_OAUTH_REDIRECT_URI=https://xn--80aanufhx.xn--b1ajdba5acbodeeeaj1qb.xn--p1ai/oauth/yandex/callback
METRIKA_OAUTH_TIMEOUT_SECONDS=30
# Generate a Fernet key once and keep it backed up. Changing it without re-encryption breaks stored tokens
# AND lk.py's encrypted Bitrix24 webhook secrets — this key is shared by both.
METRIKA_TOKEN_ENCRYPTION_KEY=

# /lk ("Конверсии в Метрику") background worker — polls Bitrix24 sources
# and uploads offline conversions to Metrika. Set to 0 to disable (e.g. in
# tests); LK_POLL_SECONDS is the polling interval, minimum 120.
LK_WORKER=1
LK_POLL_SECONDS=600

# Optional: execute requests as a child user under your Click.ru master account.
CLICKRU_USER_ID=
CLICKRU_API_BASE_URL=https://api.click.ru/V0
CLICKRU_TIMEOUT_SECONDS=30

# ParsYa's shared Yandex-account pool (MySQL, reached via parsya-control on
# 127.0.0.1:8091 over the reverse SSH tunnel from WSL). Required — this is
# the only source of Yandex ID + Metrika OAuth token addAvto uses; there is
# no separate manual OAuth-connect flow in this app.
PARSYA_POOL_API_URL=http://127.0.0.1:8091
PARSYA_POOL_API_TOKEN=
PARSYA_POOL_API_TIMEOUT_SECONDS=10
